#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

usage() {
  cat >&2 <<'EOF'
usage: scripts/setup-arm-builder [SSH_HOST]
       scripts/setup-arm-builder [options]

Options:
  --host HOST       SSH host, default: zimengx@osxserver.lan
  --instance NAME   Lima instance name, default: basics-arm-builder
  --repo DIR        Repo path inside the Lima VM, default: __GUEST_HOME__/Projects/basicsvm

Bootstraps the aarch64 Linux builder used by scripts/build-release arm.
The SSH password is never stored by this script; install an SSH key for the
host account before expecting unattended release builds.
EOF
}

host="${BASICS_ARM_BUILDER:-zimengx@osxserver.lan}"
instance="${BASICS_ARM_LIMA:-basics-arm-builder}"
arm_repo="${BASICS_ARM_REPO:-__GUEST_HOME__/Projects/basicsvm}"

while [[ $# -gt 0 ]]; do
  case "$1" in
    --host)
      host="${2:?missing --host value}"
      shift 2
      ;;
    --instance)
      instance="${2:?missing --instance value}"
      shift 2
      ;;
    --repo)
      arm_repo="${2:?missing --repo value}"
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *@*|*.lan)
      host="$1"
      shift
      ;;
    *)
      echo "unknown option: $1" >&2
      usage
      exit 2
      ;;
  esac
done

remote_tmp="/tmp/basics-arm-builder.yaml"
repo_url="$(git remote get-url origin)"
case "$repo_url" in
  git@github.com:*)
    repo_url="https://github.com/${repo_url#git@github.com:}"
    ;;
esac

if ! ssh -o BatchMode=yes -o ConnectTimeout=10 "$host" 'true' >/dev/null 2>&1; then
  cat >&2 <<EOF
Cannot reach $host with public-key SSH.

Install a key first, for example:
  ssh-copy-id $host

Then rerun:
  scripts/setup-arm-builder --host $host
EOF
  exit 1
fi

scp "$repo_root/config/lima/basics-arm-builder.yaml" "$host:$remote_tmp" >/dev/null

ssh "$host" /bin/bash -s -- "$instance" "$remote_tmp" <<'REMOTE'
set -euo pipefail
instance="$1"
remote_tmp="$2"
export PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"

if [[ "$(uname -s)" != "Darwin" ]]; then
  echo 'The ARM builder host should be macOS with Lima installed.' >&2
  exit 1
fi

if ! command -v limactl >/dev/null 2>&1; then
  if command -v brew >/dev/null 2>&1; then
    brew install lima
  else
    mkdir -p "$HOME/.local"
    version="$(curl -fsSL https://api.github.com/repos/lima-vm/lima/releases/latest | sed -n 's/.*"tag_name": "\(v[^"]*\)".*/\1/p' | head -1)"
    if [[ -z "$version" ]]; then
      echo 'Could not discover the latest Lima release from GitHub.' >&2
      exit 1
    fi
    version_no_v="${version#v}"
    url="https://github.com/lima-vm/lima/releases/download/$version/lima-$version_no_v-Darwin-arm64.tar.gz"
    echo "Installing Lima $version into $HOME/.local"
    curl -fL "$url" | tar -xz -C "$HOME/.local"
  fi
fi

if ! find "$HOME/.local" -name '*Linux-aarch64*' -type f | grep -q .; then
  version_no_v="$(limactl --version | sed -n 's/.*version \([0-9][^ ]*\).*/\1/p' | head -1)"
  if [[ -z "$version_no_v" ]]; then
    echo 'Could not determine Lima version for guest agent installation.' >&2
    exit 1
  fi
  url="https://github.com/lima-vm/lima/releases/download/v$version_no_v/lima-additional-guestagents-$version_no_v-Darwin-arm64.tar.gz"
  echo "Installing Lima additional guest agents $version_no_v into $HOME/.local"
  curl -fL "$url" | tar -xz -C "$HOME/.local"
fi

if ! limactl list "$instance" >/dev/null 2>&1; then
  limactl start --name "$instance" "$remote_tmp"
elif ! limactl list "$instance" 2>/dev/null | awk 'NR > 1 { print $2 }' | grep -q '^Running$'; then
  limactl start "$instance"
fi
REMOTE

ssh "$host" /bin/bash -s -- "$instance" "$arm_repo" "$repo_url" <<'REMOTE'
set -euo pipefail
instance="$1"
arm_repo="$2"
repo_url="$3"
export PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"

limactl shell "$instance" -- bash -s -- "$arm_repo" "$repo_url" <<'GUEST'
set -euo pipefail
arm_repo="$1"
repo_url="$2"
guest_home="$(getent passwd "$(id -un)" | cut -d: -f6)"
export HOME="$guest_home"
cd "$HOME"

case "$arm_repo" in
  "__GUEST_HOME__/"*) arm_repo="$HOME/${arm_repo#"__GUEST_HOME__/"}" ;;
  "~/"*) arm_repo="$HOME/${arm_repo#"~/"}" ;;
esac

mkdir -p ~/Projects
if [[ -d "$arm_repo/.git" ]]; then
  cd "$arm_repo"
  git remote set-url origin "$repo_url"
  git fetch --all --prune
  git checkout main
  git pull --ff-only
else
  git clone "$repo_url" "$arm_repo"
  cd "$arm_repo"
fi
BASICS_USE_SYSTEM_NIX=1 scripts/nix --version
qemu-img --version
df -h .
free -h
GUEST
REMOTE

cat <<EOF
ARM builder is ready.

Use:
  BASICS_ARM_BUILDER=$host BASICS_ARM_LIMA=$instance scripts/build-release arm
EOF
