#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

usage() {
  cat >&2 <<'EOF'
usage: scripts/release-all

Builds every VM target, finalizes the release tree, uploads it to Hugging Face,
updates docs download links, builds docs, commits the docs link update, and
pushes main.

Requires a clean git tree before it starts.

By default, completed target packages in out/release are reused. Set
BASICS_RELEASE_CLEAN=1 to discard out/release before building.
EOF
}

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  usage
  exit 0
fi

if [[ $# -ne 0 ]]; then
  usage
  exit 2
fi

if [[ -n "$(git status --short)" ]]; then
  echo "git tree is dirty; commit or stash changes before running release-all" >&2
  git status --short >&2
  exit 1
fi

version="${BASICS_RELEASE_VERSION:-$(git rev-parse --short HEAD)}"
arm_builder="${BASICS_ARM_BUILDER:-zimengx@osxserver.lan}"
arm_lima="${BASICS_ARM_LIMA:-basics-arm-builder}"
arm_repo="${BASICS_ARM_REPO:-/home/zimengx.guest/Projects/basicsvm}"
arm_docker="${BASICS_ARM_DOCKER:-0}"
out_root="$(scripts/setup-release-storage)"

echo "Release version: $version"
echo "Output root: $out_root"
echo "Cleaning generated final outputs while preserving caches"
for path in out/final out/final-current; do
  if [[ -e "$path" ]]; then
    rm -rf "$path" 2>/dev/null || mv "$path" "out/stale-$(basename "$path")-$(date +%Y%m%d%H%M%S)"
  fi
done
if [[ "${BASICS_RELEASE_CLEAN:-0}" == "1" && -e out/release ]]; then
  rm -rf out/release 2>/dev/null || mv out/release "out/stale-release-$(date +%Y%m%d%H%M%S)"
fi
mkdir -p out/release

target_is_complete() {
  local target="$1"
  local format="$2"
  local image_glob="$3"
  local bundle_glob="${4:-}"
  local source_dir="out/release/$target/$format"
  local readme="$source_dir/README.txt"

  [[ -s "$readme" ]] || return 1

  shopt -s nullglob
  local images=("$source_dir"/$image_glob)
  local bundles=()
  if [[ -n "$bundle_glob" ]]; then
    bundles=("$source_dir"/$bundle_glob)
  fi
  shopt -u nullglob

  [[ "${#images[@]}" -eq 1 && -s "${images[0]}" ]] || return 1
  if [[ -n "$bundle_glob" ]]; then
    [[ "${#bundles[@]}" -eq 1 && -s "${bundles[0]}" ]] || return 1
    if [[ "$format" == "utm" ]]; then
      local bundle_size
      bundle_size="$(stat -c '%s' "${bundles[0]}")"
      [[ "$bundle_size" -lt $((8 * 1024 * 1024 * 1024)) ]] || return 1
    fi
  fi
}

build_target() {
  local target="$1"
  local log_dir="out/release-logs"
  mkdir -p "$log_dir"

  echo "Building $target"
  case "$target" in
    macos-intel|windows-x86|linux-x86)
      scripts/build-release "$target" 2>&1 | tee "$log_dir/$target.log"
      ;;
    macos-apple-silicon|windows-arm|linux-arm)
      BASICS_ARM_BUILDER="$arm_builder" BASICS_ARM_LIMA="$arm_lima" \
        BASICS_ARM_REPO="$arm_repo" BASICS_ARM_DOCKER="$arm_docker" \
        scripts/build-release "$target" 2>&1 | tee "$log_dir/$target.log"
      ;;
    *)
      echo "unknown release target: $target" >&2
      exit 2
      ;;
  esac
}

ensure_target() {
  local target="$1"
  local format="$2"
  local image_glob="$3"
  local bundle_glob="${4:-}"

  if target_is_complete "$target" "$format" "$image_glob" "$bundle_glob"; then
    echo "Reusing completed $target package"
    return 0
  fi

  rm -rf "out/release/$target"
  build_target "$target"

  if ! target_is_complete "$target" "$format" "$image_glob" "$bundle_glob"; then
    echo "$target build finished, but required release artifacts are missing" >&2
    echo "See out/release-logs/$target.log" >&2
    exit 1
  fi
}

echo "Building or reusing release targets"
ensure_target macos-intel utm '*.utm.zip'
ensure_target windows-x86 virtualbox '*.ova'
ensure_target linux-x86 virtualbox '*.ova'
ensure_target macos-apple-silicon utm '*.utm.zip'
ensure_target windows-arm virtualbox '*.ova'
ensure_target linux-arm qemu '*.qcow2'

echo "Finalizing release tree"
scripts/finalize-release

echo "Uploading release to Hugging Face"
scripts/upload-hf-release --source out/final --version "$version"

echo "Updating docs download links"
scripts/update-release-links "$version"

echo "Building docs"
npm --prefix content/docs-site run build

if [[ -n "$(git status --short content/docs-site)" ]]; then
  git add content/docs-site
  git commit -m "Update docs for release $version"
  git push
else
  echo "Docs already pointed at release $version; nothing to commit."
fi

echo "Release complete:"
echo "  https://huggingface.co/datasets/zimengxiong/basicsvm/tree/main/releases/$version"
