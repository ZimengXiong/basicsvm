#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

work_root="${BASICS_ADDER_DOC_WORK:-$repo_root/out/adder-doc-validation}"
pdk_result="$repo_root/out/result-adder-doc-pdks"
pdk_root="$pdk_result/share/basics/pdks"

echo "== build docs runtime inputs for $(uname -m) =="
"$repo_root/scripts/nix" build .#basics-pdks -o "$pdk_result"

rm -rf "$work_root"
mkdir -p "$work_root"

echo "== run adder-from-scratch guide commands =="
"$repo_root/scripts/nix" shell .#basics-profile --command bash -s -- "$work_root" "$pdk_root" <<'VALIDATE'
set -euo pipefail

work_root="$1"
pdk_root="$2"

export PDK_ROOT="$pdk_root"

cd "$work_root"

echo "== Create the project =="
mkdir -p home/bASICs/work
cd home/bASICs/work
mkdir -p adder2/src
cd adder2

echo "== Write the RTL =="
cat > src/adder2.v <<'VERILOG'
module adder2 (
    input wire clk,        // Clock: the output updates on its rising edge.
    input wire rst_n,      // Active-low reset: reset is active when this is 0.
    input wire [1:0] a,    // First 2-bit input. It can hold values 0 through 3.
    input wire [1:0] b,    // Second 2-bit input. It can hold values 0 through 3.
    output reg [2:0] sum   // 3-bit output. 3 + 3 = 6, which needs 3 bits.
);
    // This block describes flip-flops. It runs on the clock edge and also
    // responds immediately when reset falls.
    always @(posedge clk or negedge rst_n) begin
        if (!rst_n) begin
            sum <= 3'b000; // Put the registered output in a known reset state.
        end else begin
            sum <= a + b;  // Store the addition result on the next clock edge.
        end
    end
endmodule
VERILOG

echo "== Write a testbench =="
cat > src/adder2_tb.v <<'VERILOG'
`timescale 1ns / 1ps // Simulation time unit is 1 ns; precision is 1 ps.

module adder2_tb;
    // These are driven by the testbench.
    reg clk = 0;
    reg rst_n = 0;
    reg [1:0] a = 0;
    reg [1:0] b = 0;

    // This observes the design output.
    wire [2:0] sum;

    // Instantiate the design under test and connect each port by name.
    adder2 dut (
        .clk(clk),
        .rst_n(rst_n),
        .a(a),
        .b(b),
        .sum(sum)
    );

    // Toggle the clock every 5 ns, making a 10 ns clock period.
    always #5 clk = ~clk;

    initial begin
        // Write a waveform file that GTKWave can open.
        $dumpfile("adder2.vcd");
        $dumpvars(0, adder2_tb);

        // Release reset after a little more than one clock edge.
        #12 rst_n = 1;

        // Drive 1 + 2, wait one clock, then check the registered result.
        a = 2'd1; b = 2'd2; #10;
        if (sum !== 3'd3) $fatal(1, "1 + 2 failed");

        // Drive the largest 2-bit addition, then check that 3 bits are enough.
        a = 2'd3; b = 2'd3; #10;
        if (sum !== 3'd6) $fatal(1, "3 + 3 failed");

        // End a passing simulation.
        $finish;
    end
endmodule
VERILOG

echo "== Simulate =="
verilator --lint-only src/adder2.v
iverilog -g2012 -o adder2_tb src/adder2.v src/adder2_tb.v
vvp adder2_tb
test -s adder2.vcd
command -v gtkwave >/dev/null

echo "== Synthesize RTL =="
mkdir -p runs
yosys -p "read_verilog src/adder2.v; synth -top adder2; write_verilog runs/adder2.synth.v" > runs/yosys-doc.log
test -s runs/adder2.synth.v

echo "== Pick the PDK =="
echo "$PDK_ROOT"
test -d "$PDK_ROOT/sky130A"

echo "== Add Timing Constraints =="
cat > src/impl.sdc <<'SDC'
create_clock [get_ports clk] -name clk -period 10
SDC

cat > src/signoff.sdc <<'SDC'
create_clock [get_ports clk] -name clk -period 10
SDC

echo "== Add Pin Order =="
cat > pin_order.cfg <<'PIN_ORDER'
#N
clk
rst_n

#S
a.*
b.*
sum.*
PIN_ORDER

echo "== Write OpenLane Config =="
cat > config.yaml <<'YAML'
DESIGN_NAME: adder2
VERILOG_FILES: dir::src/adder2.v
CLOCK_PORT: clk
CLOCK_PERIOD: 10

PNR_SDC_FILE: dir::src/impl.sdc
SIGNOFF_SDC_FILE: dir::src/signoff.sdc
FP_PIN_ORDER_CFG: dir::pin_order.cfg

FP_CORE_UTIL: 30
PL_TARGET_DENSITY_PCT: 55

FP_PDN_VOFFSET: 5
FP_PDN_HOFFSET: 5
FP_PDN_VWIDTH: 2
FP_PDN_HWIDTH: 2
FP_PDN_VPITCH: 30
FP_PDN_HPITCH: 30
FP_PDN_SKIPTRIM: true

pdk::sky130*:
  STD_CELL_LIBRARY: sky130_fd_sc_hd
YAML

echo "== Run OpenLane =="
if ! openlane --manual-pdk --pdk sky130A --pdk-root "$PDK_ROOT" config.yaml > runs/openlane-doc.log 2>&1; then
    tail -200 runs/openlane-doc.log
    exit 1
fi

echo "== Check the Output =="
run_dir="$(find runs -maxdepth 1 -mindepth 1 -type d | sort | tail -1)"
echo "$run_dir"
tree "$run_dir/final" -L 1
test -s "$run_dir/final/gds/adder2.gds"

# The docs open GTKWave and KLayout as desktop GUI commands. This verifier runs
# in a shell, so it checks that the viewer commands exist and that KLayout can
# read the generated GDS in batch mode.
command -v klayout >/dev/null
klayout_check="$(mktemp --suffix=.rb)"
cat > "$klayout_check" <<'RUBY'
layout = RBA::Layout::new
layout.read($input)
raise "empty layout" if layout.cells == 0
RUBY
klayout -b -r "$klayout_check" -rd input="$run_dir/final/klayout_gds/adder2.klayout.gds"
rm -f "$klayout_check"

echo "adder-from-scratch guide verified"
VALIDATE
