#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

usage() {
  cat >&2 <<'EOF'
usage: scripts/build-release TARGET...

Targets:
  all                  build every supported release target
  local                build local preview VM only
  x86                  build macos-intel, windows-x86, linux-x86
  arm                  build macos-apple-silicon, windows-arm, linux-arm
  macos-apple-silicon
  macos-intel
  windows-x86
  windows-arm
  linux-x86
  linux-arm

Environment:
  BASICS_ARM_BUILDER   ssh host that can run aarch64-linux builds
  BASICS_ARM_REPO      repo path inside the ARM builder, default: /home/zimengx.guest/Projects/basicsvm
  BASICS_ARM_LIMA      Lima instance on BASICS_ARM_BUILDER, optional
  BASICS_ARM_DOCKER    set to 1 to run ARM packaging in Docker on BASICS_ARM_BUILDER

Examples:
  scripts/build-release local
  scripts/build-release x86
  BASICS_ARM_BUILDER=zimengx@osxserver.lan BASICS_ARM_LIMA=basics-arm-builder scripts/build-release arm
  BASICS_ARM_BUILDER=xzm@192.168.86.10 BASICS_ARM_REPO=~/Projects/basicsvm-build-head BASICS_ARM_DOCKER=1 scripts/build-release arm
  BASICS_ARM_BUILDER=zimengx@osxserver.lan BASICS_ARM_LIMA=basics-arm-builder scripts/build-release all
EOF
}

if [[ $# -eq 0 || "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  usage
  exit 0
fi

targets=()
for arg in "$@"; do
  case "$arg" in
    all)
      targets+=(macos-intel windows-x86 linux-x86 macos-apple-silicon windows-arm linux-arm)
      ;;
    local)
      targets+=(local)
      ;;
    x86)
      targets+=(macos-intel windows-x86 linux-x86)
      ;;
    arm)
      targets+=(macos-apple-silicon windows-arm linux-arm)
      ;;
    macos-apple-silicon|macos-intel|windows-x86|windows-arm|linux-x86|linux-arm)
      targets+=("$arg")
      ;;
    *)
      echo "unknown release target: $arg" >&2
      usage
      exit 2
      ;;
  esac
done

run_local_target() {
  local target="$1"
  case "$target" in
    local)
      exec "$repo_root/scripts/preview-vm" --rebuild
      ;;
    macos-intel|windows-x86|linux-x86)
      "$repo_root/scripts/package-vm" "$target"
      ;;
    *)
      return 1
      ;;
  esac
}

run_arm_target() {
  local target="$1"
  local builder="${BASICS_ARM_BUILDER:-}"
  local arm_repo="${BASICS_ARM_REPO:-/home/zimengx.guest/Projects/basicsvm}"
  local lima="${BASICS_ARM_LIMA:-}"
  local docker="${BASICS_ARM_DOCKER:-0}"
  local remote_cmd
  local remote_tar_cmd
  local quoted_arm_repo

  if [[ -z "$builder" ]]; then
    cat >&2 <<EOF
$target needs an aarch64-linux builder.
Set BASICS_ARM_BUILDER, for example:
  BASICS_ARM_BUILDER=zimengx@osxserver.lan BASICS_ARM_LIMA=basics-arm-builder scripts/build-release $target
EOF
    exit 1
  fi

  printf -v quoted_arm_repo '%q' "$arm_repo"
  remote_cmd="cd $quoted_arm_repo && git pull --ff-only && rm -rf out/release/$target && BASICS_USE_SYSTEM_NIX=1 scripts/package-vm $target"
  if [[ "$docker" == "1" ]]; then
    run_remote_docker_target "$builder" "$arm_repo" "$target"
    remote_tar_cmd="cd $quoted_arm_repo/out/release && tar -cf - $target"
    mkdir -p "$repo_root/out/release"
    ssh "$builder" "$remote_tar_cmd" \
      | tar -C "$repo_root/out/release" -xf -
  elif [[ -n "$lima" ]]; then
    run_lima_command "$builder" "$lima" "$remote_cmd"
    remote_tar_cmd="cd $quoted_arm_repo/out/release && tar -cf - $target"
    mkdir -p "$repo_root/out/release"
    run_lima_command "$builder" "$lima" "$remote_tar_cmd" \
      | tar -C "$repo_root/out/release" -xf -
  else
    ssh "$builder" "$remote_cmd"
    mkdir -p "$repo_root/out/release"
    ssh "$builder" "cd $arm_repo/out/release && tar -cf - $target" \
      | tar -C "$repo_root/out/release" -xf -
  fi

  if [[ "$target" == "windows-arm" ]]; then
    ensure_windows_arm_ova
  fi
}

run_remote_docker_target() {
  local builder="$1"
  local arm_repo="$2"
  local target="$3"
  ssh "$builder" "/bin/bash -s -- '$arm_repo' '$target'" <<'REMOTE'
set -euo pipefail
export PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"
arm_repo="$1"
target="$2"
arm_repo="${arm_repo/#\~/$HOME}"
cd "$arm_repo"
git pull --ff-only
rm -rf "out/release/$target"
docker_bin="$(command -v docker || true)"
if [[ -z "$docker_bin" && -x /opt/homebrew/bin/docker ]]; then
  docker_bin=/opt/homebrew/bin/docker
fi
if [[ -z "$docker_bin" ]]; then
  echo "Docker is required for BASICS_ARM_DOCKER=1" >&2
  exit 1
fi
"$docker_bin" run --rm --platform linux/arm64 --privileged \
  -v basicsvm-nix-store:/nix \
  -v "$PWD":/work \
  -w /work \
  --entrypoint sh \
  nixos/nix:2.24.11 \
  -lc "git config --global --add safe.directory /work || true
export NIX_CONFIG='experimental-features = nix-command flakes
accept-flake-config = true
extra-substituters = https://cache.nixos.org'
nix shell nixpkgs#bash nixpkgs#qemu nixpkgs#python3 nixpkgs#zstd nixpkgs#coreutils nixpkgs#findutils nixpkgs#gnugrep nixpkgs#gnused nixpkgs#gnutar nixpkgs#gzip nixpkgs#git nixpkgs#zip -c bash -lc 'export BASICS_USE_SYSTEM_NIX=1; scripts/package-vm $target'"
REMOTE
}

run_lima_command() {
  local builder="$1"
  local lima="$2"
  local command="$3"
  local quoted_lima
  local quoted_command

  printf -v quoted_lima '%q' "$lima"
  printf -v quoted_command '%q' "$command"
  ssh "$builder" "/bin/bash -s -- $quoted_lima $quoted_command" <<'REMOTE'
set -euo pipefail
export PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"
lima="$1"
command="$2"
limactl shell "$lima" -- bash -lc "$command"
REMOTE
}

ensure_windows_arm_ova() {
  local pkg_dir="$repo_root/out/release/windows-arm/virtualbox"
  local vdi="$pkg_dir/basicsvm-aarch64-linux.vdi"
  local ova="$pkg_dir/bASICs-VM-Windows-ARM.ova"
  local readme="$pkg_dir/README.txt"

  if [[ -f "$ova" ]]; then
    return 0
  fi
  if [[ ! -f "$vdi" ]]; then
    echo "windows-arm packaging did not produce $vdi or $ova" >&2
    exit 1
  fi

  if command -v VBoxManage >/dev/null 2>&1; then
    "$repo_root/scripts/create-virtualbox-appliance" "$vdi" "$ova" --ostype Debian_arm64
  else
    "$repo_root/scripts/nix" shell nixpkgs#virtualbox --command \
      "$repo_root/scripts/create-virtualbox-appliance" "$vdi" "$ova" --ostype Debian_arm64
  fi

  cat > "$readme" <<EOF
bASICs VM - windows-arm

Recommended app: VirtualBox
VM architecture: aarch64-linux
Login user: beaver
Password: works

Import this appliance in VirtualBox:
$(basename "$ova")

Suggested VM resources:
- RAM: 6 GB minimum
- CPU: 4 cores minimum
- Disk: image virtual size is about 30 GiB

The VM contains the EDA toolchain, SKY130 PDK, examples, and templates. Docs open at https://basics.alpacawebservices.com.
EOF

  (
    cd "$repo_root/out/release/windows-arm"
    : > checksums/SHA256SUMS
    sha256sum "virtualbox/$(basename "$ova")" >> checksums/SHA256SUMS
    sha256sum "virtualbox/README.txt" >> checksums/SHA256SUMS
  )
}

for target in "${targets[@]}"; do
  case "$target" in
    local|macos-intel|windows-x86|linux-x86)
      run_local_target "$target"
      ;;
    macos-apple-silicon|windows-arm|linux-arm)
      run_arm_target "$target"
      ;;
  esac
done
